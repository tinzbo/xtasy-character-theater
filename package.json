{
  "name": "xtasy-character-theater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/build-server.ts",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "media:check": "tsx scripts/check-media.ts",
    "media:build": "tsx scripts/build-media.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinzbo/xtasy-character-theater.git"
  },
  "bugs": {
    "url": "https://github.com/tinzbo/xtasy-character-theater/issues"
  }
}
